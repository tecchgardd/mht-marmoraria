OPENAI_API_KEY=
# Opcionais: modelos usados pelo assistente (padrão gpt-5.4-mini e gpt-image-2).
OPENAI_CHAT_MODEL=
OPENAI_IMAGE_MODEL=
# Neon: DATABASE_URL = URL com pooling (app); DATABASE_URL_UNPOOLED = conexão direta (migrations, host sem "-pooler").
# A integração Neon da Vercel cria as duas automaticamente.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Segredo da sessão do portal, mín. 32 caracteres. Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Cloudinary (Dashboard > API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
